{
    "name": "@lialh4/effect-dom",
    "version": "0.2.0",
    "description": "Type-safe DOM manipulation with explicit, composable error handling.",
    "keywords": [
        "typescript",
        "effect",
        "dom"
    ],
    "license": "MIT",
    "author": "LiAlH4",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lialh4qwq/effect-dom.git"
    },
    "homepage": "https://github.com/lialh4qwq/effect-dom",
    "bugs": "https://github.com/lialh4qwq/effect-dom/issues",
    "type": "module",
    "types": "./dist/dts/index.d.ts",
    "module": "./dist/esm/index.js",
    "main": "./dist/cjs/index.js",
    "engines": {
        "node": ">=26"
    },
    "exports": {
        ".": {
            "types": "./dist/dts/index.d.ts",
            "import": "./dist/esm/index.js",
            "default": "./dist/cjs/index.js"
        },
        "./Types": {
            "types": "./dist/dts/Types.d.ts",
            "import": "./dist/esm/Types.js",
            "default": "./dist/cjs/Types.js"
        },
        "./Errors": {
            "types": "./dist/dts/Errors.d.ts",
            "import": "./dist/esm/Errors.js",
            "default": "./dist/cjs/Errors.js"
        },
        "./Doc": {
            "types": "./dist/dts/Doc.d.ts",
            "import": "./dist/esm/Doc.js",
            "default": "./dist/cjs/Doc.js"
        },
        "./Elem": {
            "types": "./dist/dts/Elem.d.ts",
            "import": "./dist/esm/Elem.js",
            "default": "./dist/cjs/Elem.js"
        },
        "./Mut": {
            "types": "./dist/dts/Mut.d.ts",
            "import": "./dist/esm/Mut.js",
            "default": "./dist/cjs/Mut.js"
        },
        "./Wait": {
            "types": "./dist/dts/Wait.d.ts",
            "import": "./dist/esm/Wait.js",
            "default": "./dist/cjs/Wait.js"
        },
        "./Interact": {
            "types": "./dist/dts/Interact.d.ts",
            "import": "./dist/esm/Interact.js",
            "default": "./dist/cjs/Interact.js"
        }
    },
    "files": [
        "dist/**/*"
    ],
    "dependencies": {
        "effect": "^3.18.4"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.2.6",
        "@types/node": "^26.6.2",
        "happy-dom": "^20.14.5",
        "rolldown": "^1.2.9",
        "rolldown-plugin-dts": "^0.28.6",
        "typescript": "^5",
        "vitest": "^5.0.1"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "scripts": {
        "build": "rolldown -c",
        "compile": "pnpm build",
        "check": "pnpm check:format && pnpm check:lint && pnpm check:types",
        "check:format": "biome format --write",
        "check:lint": "biome check --write",
        "check:types": "tsc",
        "test": "vitest run",
        "prepublishOnly": "pnpm check && pnpm build"
    }
}
